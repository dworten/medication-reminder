# Copy to .env for local development:  cp .env.example .env
#
# NEVER commit .env — it is gitignored. In production these same variables are
# set in Railway → your service → Variables. See README "Deploying to Railway".

# ── Twilio credentials ────────────────────────────────────────────────────────
# Leave blank while using MOCK_MODE=true. Fill in once you have an account.
# Preferred live auth: Standard API Key SID/Secret + Account SID.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Account Auth Token. Required for webhook signature validation (API keys can't
# verify signatures), so set this in live mode even when using API key auth.
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Phone numbers (E.164 format: +1XXXXXXXXXX) ────────────────────────────────
GRANDMA_PHONE_NUMBER=+1XXXXXXXXXX
CAREGIVER_PHONE_NUMBER=+1XXXXXXXXXX
# Optional — lets you POST /trigger?target=test to call your own phone instead
TEST_PHONE_NUMBER=+1XXXXXXXXXX

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Railway: do NOT paste a literal URL. In your app service → Variables →
#   New Variable → Add Reference → DATABASE_URL from the Postgres service.
#   A reference follows credential rotation; a pasted copy silently goes stale.
#
# Locally: paste the Postgres service's DATABASE_PUBLIC_URL here. That is the
#   externally reachable proxy URL (a *.proxy.rlwy.net host on a high port).
#   The internal DATABASE_URL uses *.railway.internal, which only resolves
#   inside Railway's private network and will hang from your laptop.
#
# Used by the app at runtime AND by the Prisma CLI (see prisma.config.js).
DATABASE_URL=postgresql://user:password@host.proxy.rlwy.net:PORT/railway

# ── Timezone ──────────────────────────────────────────────────────────────────
# IANA timezone name. America/Chicago = US Central (auto-handles CST/CDT).
TIMEZONE=America/Chicago

# ── Call schedule ─────────────────────────────────────────────────────────────
# MORNING_CRON / EVENING_CRON are GONE. Call times now live in the `schedules`
# table — each row has its own time, days-of-week, timezone, contact, message
# and escalation settings. Edit them with `npm run db:studio`; the scheduler
# picks changes up within a minute, no redeploy needed.
#
# How late a schedule may still fire, in minutes. The old cron fired on an exact
# minute, so a container restarting during that minute missed the dose silently.
# This turns that into a call a few minutes late instead. Default: 5
SCHEDULE_GRACE_MINUTES=5

# ── Server ────────────────────────────────────────────────────────────────────
# Railway assigns PORT automatically — do NOT set it there. Local default 3000.
PORT=3000

# Public HTTPS URL Twilio uses to reach the webhooks.
#   Local live testing → your ngrok URL (https://xxxx.ngrok-free.app)
#   Railway            → leave UNSET; it is derived from RAILWAY_PUBLIC_DOMAIN
#                        automatically. Set it only for a custom domain.
#   Mock mode          → ignored
BASE_URL=http://localhost:3000

# ── Security ──────────────────────────────────────────────────────────────────
# Shared secret protecting POST /trigger, which places real billable calls.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Required in live mode; /trigger returns 503 without it.
TRIGGER_SECRET=

# Verify the X-Twilio-Signature header on every /webhook/* request. Leave on.
# Set to false only for local curl testing of the webhook routes.
VALIDATE_TWILIO_SIGNATURE=true

# Signs the session cookie that /api/* trusts. Without it a session id can be
# forged, and that API can change who gets called and when — so the app REFUSES
# TO START without it in live mode. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs everyone out, which is how you revoke a stolen session.
SESSION_SECRET=

# How long a login lasts, in hours. The clock restarts on each request, so an
# open tab is not signed out mid-use. Default: 720 (30 days)
SESSION_TTL_HOURS=720

# The one account that may use POST /trigger?target=test, which dials the
# TEST_PHONE_NUMBER above — a real handset belonging to whoever runs this, not a
# shared resource. Also what /api/me reports as isAdmin, so the interface can
# hide the Test buttons from everyone else.
#
# Left unset it falls back to the oldest account. That is the weaker rule: it is
# implicit, and would move to whoever registered next if the original account
# were ever deleted. Name the email.
ADMIN_EMAIL=you@example.com

# Public registration at /signup. Anyone who reaches the URL can create an
# account — and every call and text THEY schedule is placed on this deployment's
# Twilio credentials and billed to you. A new account starts empty and can only
# reach its own data, but it can still dial numbers it adds itself.
#
# Set to false to close registration immediately, no deploy needed. Default: true
SIGNUP_ENABLED=true

# Minimum password length, shared by /signup and npm run set-password.
MIN_PASSWORD_LENGTH=12

# ── Contact phone verification ────────────────────────────────────────────────
#
# A contact's number is never taken on trust: a 6-digit code goes to it by text
# or by voice call, and the contact only exists once that code comes back. The
# same applies to changing a number — the new one waits in pending_phone while
# the old one keeps ringing, so a typo is never dialled and nothing stops.
#
# Every value below is an override because these are the dials you reach for
# when something is going wrong at 9pm. Changing them from Railway takes effect
# on the next request.

# How long a code stays good. Ten minutes is generous for a text and about right
# for a voice call someone has to answer and write down. Default: 10
# VERIFICATION_CODE_TTL_MINUTES=10

# Wrong guesses before a code is burned and must be re-requested. Six digits is
# a million candidates, so without a ceiling the endpoint would answer all of
# them. Default: 5
# VERIFICATION_MAX_CHECKS=5

# ── Rate limits ──
#
# These exist because every send costs YOU money on the Twilio credentials
# above, and the endpoint accepts an arbitrary destination number. Unlimited, it
# is a free SMS gateway pointed at anyone, billed to you.

# Codes sent to any ONE number per hour. Protects whoever's phone would ring.
# Default: 5
# VERIFICATION_MAX_SENDS_PER_NUMBER=5

# Codes sent by one ACCOUNT per hour, across every number. This is the one that
# actually bounds the bill — a per-number cap of 5 does nothing about someone
# walking through a thousand different numbers. Default: 20
# VERIFICATION_MAX_SENDS_PER_ACCOUNT=20

# Seconds between sends to the same number, so a double-clicked button costs one
# message rather than two. Default: 60
# VERIFICATION_RESEND_COOLDOWN_SEC=60

# ── Behaviour ─────────────────────────────────────────────────────────────────
# true  → no real Twilio calls; interactive terminal simulation (local only)
# false → live Twilio API (requires credentials above)
MOCK_MODE=true

# These three are now FALLBACKS. A call placed from a schedule uses that
# schedule's own max_attempts / retry_delay_minutes / max_reprompts columns.
# They still apply to a manual /trigger with nothing seeded, and to a webhook
# that arrives without context (a call already in flight across a deploy).
#
# Total call attempts, counting the first one. 2 = call her, then one retry.
MAX_CALL_ATTEMPTS=2
# Minutes between retry attempts. Default: 5
RETRY_DELAY_MINUTES=3
# Times to re-ask within a single answered call before hanging up. Default: 3
MAX_REPROMPTS=3

# ── Retry sweeper ─────────────────────────────────────────────────────────────
# Retries are persisted to call_history.next_retry_at and picked up by a sweep
# that runs every minute, so a redeploy inside the retry window costs a minute
# of delay rather than the dose.
#
# How long one sweep's claim on a queued item stays valid. If a process dies
# holding a claim, the item waits this long before another run may take it.
# Long enough that a slow-but-alive call is never stolen. Default: 10
RETRY_STALE_CLAIM_MINUTES=10

# Abandon queued work older than this. A reminder call placed six hours late is
# a confusing call at the wrong time of day, not a reminder — and the ceiling
# stops a permanently failing item from retrying forever. Default: 6
RETRY_GIVE_UP_HOURS=6

# Stale-PENDING watchdog. Everything after "call created" arrives by Twilio
# webhook, so if callbacks stop reaching this server (BASE_URL drift after a
# domain change, a Twilio callback outage) every call sits PENDING forever and
# no retry or escalation ever fires. A row still PENDING after this many
# minutes is treated as unresolved: marked FAILED and run through the same
# retry-then-escalate ladder as a failed call, with a distinct "CALL NEVER
# RESOLVED" log line so callback loss is tellable from a normal no-answer.
# Values 1-9 are raised to 10 — a shorter threshold could flag a call still in
# progress and redial a dose she already confirmed. 0 disables. Default: 30
PENDING_WATCHDOG_MINUTES=30

# ── Answering machines ────────────────────────────────────────────────────────
# Ask Twilio to decide whether a human or a machine picked up, and hang up on a
# machine instead of reciting the reminder into voicemail.
#
# Without this, voicemail counts as an answered call: the message gets left, the
# machine then sits silently through every reprompt, and that lands on the
# "answered but never confirmed" branch — so the caregiver is called about a
# minute later instead of her simply being tried again.
#
# The escalation call to the caregiver is the opposite case: it DOES leave a
# message, because a voicemail saying the dose was not confirmed is a real alert
# and a text may go unread for hours. That call waits for the beep first, and
# the recording omits the "press 1" prompt a machine cannot act on.
#
# Costs a small per-call Twilio fee and delays a real person's greeting by a
# second or two. Set to false to turn it off without a redeploy if it ever
# misjudges a live person. Default: true
MACHINE_DETECTION=true

# ── Escalation chain ──────────────────────────────────────────────────────────
# When a dose cannot be confirmed, who gets told and how. Each schedule carries
# its own escalate_with_call / escalate_with_sms / escalation_ack_minutes
# columns; edit them in `npm run db:studio`. These three are only the fallback
# for an escalation with no schedule behind it (a manual /trigger).
#
# Call the fallback contact before texting them. Default: false — which is what
# this app has always done. Turn it on per schedule in Prisma Studio.
ESCALATE_WITH_CALL=false
# Text the fallback contact. Default: true. Turning BOTH off means nobody is
# alerted about a missed dose; the app logs loudly if it ever sees that.
ESCALATE_WITH_SMS=true
# NO LONGER USED. Pressing 1 on the escalation call once suppressed the text.
# Both steps now always run: the fallback contact gets a call AND a text every
# time, because a call picked up, half-heard and forgotten used to cancel the
# text — the one outcome nobody wanted. Pressing 1 is still recorded.
# ESCALATION_ACK_MINUTES=3

# ── Admin alerts — the alerts about failed alerts ─────────────────────────────
# The worst cases in this system (RETRY LOST, ESCALATION LOST, ALERT TEXT NOT
# DELIVERED, NOBODY WILL BE ALERTED, CALL NEVER RESOLVED) end in a log line,
# and nobody reads logs at 9:20 PM. Set this to your own phone and those events
# reach it directly. Unset, they stay log-only and the app says so at boot.
ADMIN_ALERT_PHONE=

# 'call' (default), 'sms', or 'both'. Voice call is the default on purpose: one
# of the events being reported is "SMS is not being delivered" (A2P 10DLC
# blocking), and an alert that rides the broken channel arrives never. The call
# speaks its message inline — no webhooks, no BASE_URL dependence — and either
# channel falls back to the other if the send fails.
ADMIN_ALERT_CHANNEL=call

# Storm guard: the same event alerts at most once per this many minutes.
# Repeats are counted and the count rides on the next alert through, so "it
# happened 14 more times" is not lost. Default: 60
ADMIN_ALERT_COOLDOWN_MINUTES=60

# Daily heartbeat hour (0-23, in TIMEZONE above): one message a day confirming
# the system is alive and summarizing the last 24 hours of calls, so silence
# stops being ambiguous — no news plus no heartbeat means the system is DOWN,
# not idle. Set to 'off' (or anything not 0-23) to disable. Default: 8
ADMIN_HEARTBEAT_HOUR=8

# ── Seed script (npm run db:seed) ─────────────────────────────────────────────
# Used only by prisma/seed.js, never by the running app. The phone numbers come
# from GRANDMA_PHONE_NUMBER / CAREGIVER_PHONE_NUMBER above.
SEED_ACCOUNT_EMAIL=you@example.com
SEED_RECIPIENT_NAME=Grandma
SEED_CAREGIVER_NAME=Caregiver
