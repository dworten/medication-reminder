# Copy to .env for local development:  cp .env.example .env
#
# NEVER commit .env — it is gitignored. In production these same variables are
# set in Railway → your service → Variables. See README "Deploying to Railway".

# ── Twilio credentials ────────────────────────────────────────────────────────
# Leave blank while using MOCK_MODE=true. Fill in once you have an account.
# Preferred live auth: Standard API Key SID/Secret + Account SID.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX

# Account Auth Token. Required for webhook signature validation (API keys can't
# verify signatures), so set this in live mode even when using API key auth.
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Phone numbers (E.164 format: +1XXXXXXXXXX) ────────────────────────────────
GRANDMA_PHONE_NUMBER=+1XXXXXXXXXX
CAREGIVER_PHONE_NUMBER=+1XXXXXXXXXX
# Optional — lets you POST /trigger?target=test to call your own phone instead
TEST_PHONE_NUMBER=+1XXXXXXXXXX

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Railway: do NOT paste a literal URL. In your app service → Variables →
#   New Variable → Add Reference → DATABASE_URL from the Postgres service.
#   A reference follows credential rotation; a pasted copy silently goes stale.
#
# Locally: paste the Postgres service's DATABASE_PUBLIC_URL here. That is the
#   externally reachable proxy URL (a *.proxy.rlwy.net host on a high port).
#   The internal DATABASE_URL uses *.railway.internal, which only resolves
#   inside Railway's private network and will hang from your laptop.
#
# Used by the app at runtime AND by the Prisma CLI (see prisma.config.js).
DATABASE_URL=postgresql://user:password@host.proxy.rlwy.net:PORT/railway

# ── Timezone ──────────────────────────────────────────────────────────────────
# IANA timezone name. America/Chicago = US Central (auto-handles CST/CDT).
TIMEZONE=America/Chicago

# ── Call schedule ─────────────────────────────────────────────────────────────
# MORNING_CRON / EVENING_CRON are GONE. Call times now live in the `schedules`
# table — each row has its own time, days-of-week, timezone, contact, message
# and escalation settings. Edit them with `npm run db:studio`; the scheduler
# picks changes up within a minute, no redeploy needed.
#
# How late a schedule may still fire, in minutes. The old cron fired on an exact
# minute, so a container restarting during that minute missed the dose silently.
# This turns that into a call a few minutes late instead. Default: 5
SCHEDULE_GRACE_MINUTES=5

# ── Server ────────────────────────────────────────────────────────────────────
# Railway assigns PORT automatically — do NOT set it there. Local default 3000.
PORT=3000

# Public HTTPS URL Twilio uses to reach the webhooks.
#   Local live testing → your ngrok URL (https://xxxx.ngrok-free.app)
#   Railway            → leave UNSET; it is derived from RAILWAY_PUBLIC_DOMAIN
#                        automatically. Set it only for a custom domain.
#   Mock mode          → ignored
BASE_URL=http://localhost:3000

# ── Security ──────────────────────────────────────────────────────────────────
# Shared secret protecting POST /trigger, which places real billable calls.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Required in live mode; /trigger returns 503 without it.
TRIGGER_SECRET=

# Verify the X-Twilio-Signature header on every /webhook/* request. Leave on.
# Set to false only for local curl testing of the webhook routes.
VALIDATE_TWILIO_SIGNATURE=true

# ── Behaviour ─────────────────────────────────────────────────────────────────
# true  → no real Twilio calls; interactive terminal simulation (local only)
# false → live Twilio API (requires credentials above)
MOCK_MODE=true

# These three are now FALLBACKS. A call placed from a schedule uses that
# schedule's own max_attempts / retry_delay_minutes / max_reprompts columns.
# They still apply to a manual /trigger with nothing seeded, and to a webhook
# that arrives without context (a call already in flight across a deploy).
#
# Total call attempts (1 initial + retries). Default: 3
MAX_CALL_ATTEMPTS=3
# Minutes between retry attempts. Default: 5
RETRY_DELAY_MINUTES=5
# Times to re-ask within a single answered call before hanging up. Default: 3
MAX_REPROMPTS=3

# ── Retry sweeper ─────────────────────────────────────────────────────────────
# Retries are persisted to call_history.next_retry_at and picked up by a sweep
# that runs every minute, so a redeploy inside the retry window costs a minute
# of delay rather than the dose.
#
# How long one sweep's claim on a queued item stays valid. If a process dies
# holding a claim, the item waits this long before another run may take it.
# Long enough that a slow-but-alive call is never stolen. Default: 10
RETRY_STALE_CLAIM_MINUTES=10

# Abandon queued work older than this. A reminder call placed six hours late is
# a confusing call at the wrong time of day, not a reminder — and the ceiling
# stops a permanently failing item from retrying forever. Default: 6
RETRY_GIVE_UP_HOURS=6
