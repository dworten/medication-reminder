{
  "name": "medication-reminder",
  "version": "1.0.0",
  "description": "Automated medication reminder phone calls via Twilio",
  "main": "app.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
    "test": "node test/run.js",
    "test:morning": "node app.js --test morning",
    "test:evening": "node app.js --test evening",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "db:history": "node scripts/history.js",
    "set-password": "node scripts/set-password.js"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.19.0",
    "node-cron": "^3.0.3",
    "pg": "^8.22.0",
    "prisma": "^7.9.1",
    "twilio": "^5.3.1"
  }
}
