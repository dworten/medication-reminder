// Medication reminder — data model.
//
// Every table carries account_id from day one. Only one account exists today,
// but designing it in now means the Phase 3 API and any future second user do
// not need a migration that rewrites every row.
//
// Naming: Prisma models are PascalCase/camelCase (idiomatic JS), mapped to
// snake_case tables and columns so raw SQL and Prisma Studio read cleanly.

// Deliberately the legacy `prisma-client-js` generator, not Prisma 7's newer
// `prisma-client`. The new one emits TypeScript source and expects the project
// to compile it; this is a plain CommonJS JS app with no build step, and adding
// tsc to the Railway build to satisfy an ORM is not a trade worth making.
// `prisma-client-js` still ships in v7 and emits require()-able CommonJS.
//
// Generated into src/ rather than node_modules so the client is a visible,
// reviewable artifact. It is gitignored — `prisma generate` recreates it.
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Prisma 7 removed `url` from the datasource block: the CLI reads it from
// prisma.config.js, and the running client gets it via the pg driver adapter in
// src/db.js.
datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

// A hint for grouping people in a future UI. It deliberately does NOT decide
// who gets called: that is a property of the schedule (contactId vs
// escalationContactId), so the same person can be the recipient on one
// schedule and the fallback on another.
enum ContactRole {
  RECIPIENT
  CAREGIVER
  BOTH

  @@map("contact_role")
}

// TTS   → Twilio <Say> with ttsText   (shown as "Voice Typed Message")
// AUDIO → Twilio <Play> with audioUrl (shown as "Voice Recorded Message")
// TEXT  → an SMS body, stored in ttsText; never spoken on a call
enum MessageKind {
  TTS
  AUDIO
  TEXT

  @@map("message_kind")
}

// How a contact's phone number came to be trusted.
//
// GRANDFATHERED exists so the two contacts that predate verification are
// distinguishable forever from ones that actually passed a code. They were
// stamped by the migration on the strength of having received real calls for
// months, which is good evidence — but it is not the same evidence, and
// flattening the two would make that unrecoverable.
enum PhoneVerificationMethod {
  SMS
  CALL
  GRANDFATHERED

  @@map("phone_verification_method")
}

// How a verification code was delivered. Deliberately NOT the same enum as
// above: a verification can never be GRANDFATHERED, and sharing the type would
// make that state representable.
//
// CALL is not a nicety. The person being reminded is elderly and may not read a
// text at all, so a number that can only be verified by SMS is a number that
// cannot be verified.
enum VerificationChannel {
  SMS
  CALL

  @@map("verification_channel")
}

// What a call_history row represents. Stage 4 logs every escalation step as its
// own row, so the chain is auditable rather than inferred from a flag.
enum CallKind {
  REMINDER_CALL
  ESCALATION_CALL
  ESCALATION_SMS

  @@map("call_kind")
}

enum CallOutcome {
  PENDING // placed, no terminal status yet
  CONFIRMED // she pressed 1 / said yes
  NOT_CONFIRMED // answered, but never confirmed after all reprompts
  NO_ANSWER
  BUSY
  FAILED // Twilio rejected it, or the API call threw
  // Handed to Twilio and accepted. NOT proof anyone received it — for an SMS
  // that verdict comes minutes later, from the carrier, via /webhook/sms-status.
  // Reading SENT as success is what hid a week of undelivered alerts.
  SENT
  // The carrier confirmed it arrived. The only outcome that actually means a
  // caregiver's phone buzzed.
  DELIVERED
  CANCELED

  @@map("call_outcome")
}

// ─── Tables ───────────────────────────────────────────────────────────────────

// Login sessions, written and read by connect-pg-simple rather than by Prisma.
//
// Modelled here anyway so `prisma migrate` stays the single source of truth for
// the schema — a table created behind Prisma's back shows up as drift forever
// after. The column names and types are the ones connect-pg-simple expects and
// are not ours to rename.
//
// Sessions live in Postgres rather than in memory because the default
// MemoryStore drops every login on redeploy, and this app redeploys often.
model Session {
  sid    String   @id
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire])
  @@map("session")
}

model Account {
  id       String  @id @default(uuid()) @db.Uuid
  email    String  @unique
  name     String?
  timezone String  @default("America/Chicago")

  // Set by `npm run set-password`, never by a signup flow — there is one
  // account and it is created by the seed. Nullable on purpose: an account that
  // has never had a password set must not be loginable, and NULL is the only
  // state that cannot be matched by any hash comparison.
  passwordHash String?   @map("password_hash")
  lastLoginAt  DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  contacts      Contact[]
  messages      Message[]
  schedules     Schedule[]
  callHistory   CallHistory[]
  verifications ContactVerification[]

  @@map("accounts")
}

model Contact {
  id        String      @id @default(uuid()) @db.Uuid
  accountId String      @map("account_id") @db.Uuid
  name      String
  // E.164, e.g. +15125550123.
  //
  // THE INVARIANT: this column only ever holds a number that has passed a
  // verification code (or was grandfathered in). Nothing writes to it except
  // the verification check. That is what makes "a schedule cannot call an
  // unverified number" true by construction rather than by vigilance — a typo
  // never becomes a live destination, because it never reaches this column.
  phone     String
  notes     String?
  role      ContactRole @default(RECIPIENT)
  isActive  Boolean     @default(true) @map("is_active")

  // When `phone` passed its code, and how it was delivered.
  //
  // Nullable rather than NOT NULL, even though every row created after this
  // feature has one set. NULL is the fail-closed state: a row that somehow
  // arrives without a stamp — a hand-written INSERT in Prisma Studio, a future
  // migration that forgets — is refused by the schedule trigger rather than
  // silently trusted. Making it NOT NULL would also make "I no longer trust
  // this number" impossible to express.
  phoneVerifiedAt  DateTime?                @map("phone_verified_at")
  phoneVerifiedVia PhoneVerificationMethod? @map("phone_verified_via")

  // A number waiting on its code. NEVER called, never texted, never resolved by
  // the call path — it is a proposal, not a destination.
  //
  // This column is the whole reason changing a phone number cannot break a live
  // schedule: the edit lands here, `phone` keeps its verified value and keeps
  // ringing, and the two swap only when a code comes back correct. Without it,
  // editing a number would either stop the calls or start sending them to an
  // unproven number, and both are the failure this feature exists to prevent.
  pendingPhone String? @map("pending_phone")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Restrict, not Cascade: deleting a contact must not silently delete the
  // schedules that call her, or the history of calls already placed.
  schedulesAsRecipient  Schedule[]            @relation("ScheduleRecipient")
  schedulesAsEscalation Schedule[]            @relation("ScheduleEscalation")
  callHistory           CallHistory[]
  verifications         ContactVerification[]

  @@unique([accountId, phone])
  @@index([accountId])
  @@map("contacts")
}

// One attempt to prove that a phone number belongs to whoever is adding it.
//
// It is a table rather than an in-memory map for two reasons. The rate limits
// are counted from it, and an in-memory counter resets on every redeploy — which
// turns "5 texts per number per hour" into "5 texts per redeploy", on an endpoint
// that spends the account owner's Twilio balance. And a code that outlived the
// process that issued it would be a code nobody could check.
//
// The code itself is never here. Only a bcrypt hash of it, which is what makes a
// leak of this table useless: 10^6 candidates at cost 12 is days of work per
// code, against a code that expires in ten minutes and is burned after five
// wrong guesses.
model ContactVerification {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid

  // NULL means "this number has no contact yet" — the create flow. The contact
  // row does not exist until the code checks out, so there is never a
  // half-finished contact sitting in the list waiting to be completed.
  contactId String? @map("contact_id") @db.Uuid

  // The number the code was sent to. Snapshotted rather than read back through
  // contactId, because for the create flow there is nothing to read it from,
  // and because the rate limit must count sends to a NUMBER regardless of which
  // contact (or none) they were for.
  phone   String
  channel VerificationChannel

  codeHash String @map("code_hash")

  // The contact-to-be: name, role, notes — everything except the phone, which
  // is the column above. Set only on the create flow.
  //
  // JSON rather than three mirrored columns so it cannot drift as Contact
  // grows. It is re-validated through the same contactInput() on the way out as
  // it was on the way in, so nothing unchecked reaches the contacts table.
  draft Json?

  expiresAt     DateTime  @map("expires_at")
  // Set when the right code was entered. Also the single-use latch: a consumed
  // row is refused, so the same code cannot create two contacts.
  consumedAt    DateTime? @map("consumed_at")
  // Set when the code was burned rather than used — attempts exhausted, expired
  // on inspection, or superseded by a newer code for the same number. Separate
  // from consumedAt so the history says which of the two happened.
  invalidatedAt DateTime? @map("invalidated_at")
  checkAttempts Int       @default(0) @map("check_attempts")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  // The two rate-limit queries, in index form: sends to one number in the last
  // hour, and sends by one account in the last hour.
  @@index([accountId, phone, createdAt])
  @@index([accountId, createdAt])
  @@index([contactId])
  @@map("contact_verifications")
}

model Message {
  id        String      @id @default(uuid()) @db.Uuid
  accountId String      @map("account_id") @db.Uuid
  name      String // "Morning reminder"
  kind      MessageKind @default(TTS)
  ttsText   String?     @map("tts_text")
  audioUrl  String?     @map("audio_url")
  // Twilio <Say> attributes, only meaningful when kind = TTS.
  // null voice = Twilio's default, which is what the app uses today.
  voice     String?
  language  String?
  // At most one default per account, enforced by a partial unique index added
  // by hand in the migration (Prisma cannot express `WHERE is_default`).
  isDefault Boolean     @default(false) @map("is_default")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  schedules Schedule[]

  @@index([accountId])
  @@map("messages")
}

model Schedule {
  id        String @id @default(uuid()) @db.Uuid
  accountId String @map("account_id") @db.Uuid
  name      String // "Morning meds"

  // 'morning' | 'evening'. Stored as a plain string, not an enum, on purpose:
  // this exact value travels in the Twilio webhook query string
  // (/webhook/initial?dose=morning) and picks the goodbye line in
  // twimlHandler. Keeping it a string means zero translation in the live call
  // path, which is the part that must not break.
  dose String

  // Android-clock semantics: a wall-clock time plus a set of days, resolved in
  // `timezone`. Not a cron string — a UI can render this directly.
  timeOfDay  String @map("time_of_day") // "09:20", 24-hour
  daysOfWeek Int[]  @map("days_of_week") // 0 = Sunday .. 6 = Saturday
  timezone   String @default("America/Chicago")

  enabled Boolean @default(true)

  contactId String  @map("contact_id") @db.Uuid
  messageId String? @map("message_id") @db.Uuid

  // ── Escalation settings (defaults mirror today's env vars) ──
  maxAttempts         Int     @default(3) @map("max_attempts")
  retryDelayMinutes   Int     @default(5) @map("retry_delay_minutes")
  maxReprompts        Int     @default(3) @map("max_reprompts")
  escalationContactId String? @map("escalation_contact_id") @db.Uuid
  escalateWithCall    Boolean @default(false) @map("escalate_with_call")
  escalateWithSms     Boolean @default(true) @map("escalate_with_sms")

  // RETAINED, NO LONGER READ. It was the window in which acknowledging the
  // escalation call suppressed the follow-up text. Both steps now always run —
  // a call picked up, half-heard and forgotten used to cancel the text, which
  // was the one outcome nobody wanted — so nothing consults this. Kept rather
  // than dropped because removing a column is irreversible and it costs
  // nothing to leave.
  escalationAckMinutes Int @default(3) @map("escalation_ack_minutes")

  // Set by the scheduler after a successful fire, so a restart inside the same
  // minute cannot fire the same schedule twice.
  lastFiredAt DateTime? @map("last_fired_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account           Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contact           Contact       @relation("ScheduleRecipient", fields: [contactId], references: [id], onDelete: Restrict)
  escalationContact Contact?      @relation("ScheduleEscalation", fields: [escalationContactId], references: [id], onDelete: Restrict)
  message           Message?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  callHistory       CallHistory[]

  @@index([accountId])
  @@index([enabled])
  @@map("schedules")
}

model CallHistory {
  id         String  @id @default(uuid()) @db.Uuid
  accountId  String  @map("account_id") @db.Uuid
  // Null for manual /trigger test calls, which belong to no schedule.
  // SetNull rather than Cascade: deleting a schedule must not erase the
  // evidence that calls were placed.
  scheduleId String? @map("schedule_id") @db.Uuid
  contactId  String? @map("contact_id") @db.Uuid

  kind          CallKind    @default(REMINDER_CALL)
  dose          String
  attempt       Int         @default(1)
  repromptCount Int         @default(0) @map("reprompt_count")
  outcome       CallOutcome @default(PENDING)

  // The number this attempt was actually dialled at (or texted).
  //
  // contact_id says who the attempt was ABOUT; this says where it went, and the
  // two differ whenever a destination is overridden — /trigger?target=test being
  // the case that matters. Without it the retry rebuilt the destination from the
  // contact, so a test call's first attempt rang the test phone and its retry
  // rang the real contact partway through the sequence.
  //
  // Nullable: rows written before this column existed fall back to the contact.
  toPhone String? @map("to_phone")

  // Twilio's Call SID (or Message SID for ESCALATION_SMS). Unique when set;
  // Postgres allows many NULLs under a unique constraint, which is what we want
  // for rows created before the API call returns.
  callSid String? @unique @map("call_sid")

  startedAt   DateTime  @default(now()) @map("started_at")
  completedAt DateTime? @map("completed_at")

  // ── Retry sweeper (Stage 3) ──
  // nextRetryAt is the durable replacement for the in-memory setTimeout: a
  // redeploy mid-window loses nothing because the intent lives in Postgres.
  nextRetryAt    DateTime? @map("next_retry_at")
  // Claimed atomically by the sweeper before firing, so two processes can never
  // both pick up the same retry. Replicas stay at 1, but this makes a double
  // call impossible rather than merely unlikely.
  retryClaimedAt DateTime? @map("retry_claimed_at")

  errorMessage String? @map("error_message")

  // ── Escalation chain (Stage 4) ──
  // Points at the step that caused this one: an ESCALATION_SMS points at the
  // ESCALATION_CALL that went unacknowledged, which points at the REMINDER_CALL
  // that was never confirmed. The whole chain is then one query rather than
  // something inferred from timestamps, which is what makes "why did I get this
  // text?" answerable — and what the Phase 3 API will render.
  //
  // It is also the idempotency key: before queueing a step, the chain is asked
  // whether that child already exists, so a re-run cannot double-call.
  //
  // (parent_id, kind) is UNIQUE, which is what actually enforces "the caregiver
  // is alerted once". Checking for an existing child before inserting is a read
  // followed by a write, and two duplicate Twilio status callbacks arriving
  // milliseconds apart can both pass that check. Postgres cannot be raced.
  // Many NULL parent_ids coexist, since NULLs are distinct in a unique index.
  parentId String? @map("parent_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  account  Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  schedule Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)

  // SetNull, not Cascade: pruning an old reminder row must not delete the record
  // that a caregiver was alerted.
  parent   CallHistory?  @relation("EscalationChain", fields: [parentId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  children CallHistory[] @relation("EscalationChain")

  @@unique([parentId, kind])
  @@index([accountId, startedAt])
  @@index([scheduleId, startedAt])
  @@index([nextRetryAt])
  @@map("call_history")
}
